{
  "name": "opencode-router-monorepo",
  "version": "1.0.0",
  "description": "High-performance OpenCode Router (OCR) & Cascading Gateway",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "ocr": "bun backend/src/cli/index.ts",
    "setup": "bun install && bun run build",
    "dev": "bun run scripts/dev.ts",
    "dev:backend": "bun --filter @opencode-router/backend dev",
    "dev:frontend": "bun --filter @opencode-router/frontend dev",
    "build": "bun run build:backend && bun run build:frontend",
    "build:backend": "bun --filter @opencode-router/backend build",
    "build:frontend": "bun --filter @opencode-router/frontend build",
    "start": "bun --filter @opencode-router/backend start",
    "test": "bun --filter @opencode-router/backend test",
    "test:node": "bun --filter @opencode-router/backend test:node",
    "test:system": "bun run scripts/full-system-test.ts",
    "typecheck": "bun --filter @opencode-router/backend typecheck && bun --filter @opencode-router/frontend typecheck",
    "train:layer1": "bun run scripts/train-layer1-classifier.ts",
    "flywheel:stats": "bun run scripts/flywheel-stats.ts"
  },
  "keywords": [
    "llm",
    "router",
    "finops",
    "cascading",
    "openai-proxy",
    "semantic-cache",
    "deepseek",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "bin": {
    "ocr": "./bin/ocr",
    "opencode-router": "./bin/opencode-router"
  }
}